{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stock Market Ka Don",
  "version": "2.0.0",
  "identifier": "com.dangerlabs.smkd",
  "build": {
    "beforeDevCommand": "python scripts/stage_backend.py",
    "beforeBuildCommand": "python scripts/stage_backend.py",
    "frontendDist": "../bundle/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Stock Market Ka Don",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "url": "splash.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Finance",
    "shortDescription": "Local NSE stock analysis and paper trading dashboard",
    "resources": {
      "../bundle/backend": "backend",
      "../scripts/prepare_backend.ps1": "bootstrap/prepare_backend.ps1",
      "../scripts/ensure_webview.ps1": "bootstrap/ensure_webview.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "languages": ["English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/dr-week/STOCK-MARKET-KA-DON/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
